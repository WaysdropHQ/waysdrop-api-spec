{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.waysdrop.com/schemas/webhooks/payment.refunded.v1.json",
  "title": "Waysdrop webhook: payment.refunded",
  "description": "Envelope for `payment.refunded` (apiVersion 2026-11-25). Delivery is at least once: dedupe on `id`; drop events whose `sequence` is lower than one already seen for the same object.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "apiVersion",
    "createdAt",
    "livemode",
    "account",
    "sequence",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evt_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "type": {
      "const": "payment.refunded"
    },
    "apiVersion": {
      "const": "2026-11-25"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "livemode": {
      "type": "boolean"
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object"
      ],
      "properties": {
        "object": {
          "$ref": "#/$defs/Object"
        },
        "previous": {
          "type": "object",
          "description": "Changed fields only, when known"
        }
      }
    }
  },
  "$defs": {
    "Money": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amountMinor",
        "currency"
      ],
      "properties": {
        "amountMinor": {
          "type": "string",
          "pattern": "^-?[0-9]{1,30}$",
          "description": "Integer minor units as a string"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "Address": {
      "type": "object",
      "additionalProperties": false,
      "description": "Subset of PARTNER_ADDRESS_SELECT. Contact fields are the ones the partner supplied.",
      "required": [
        "id",
        "label",
        "addressLine1",
        "addressLine2",
        "floor",
        "city",
        "state",
        "region",
        "country",
        "countryCode",
        "zipCode",
        "lat",
        "lng",
        "contactName",
        "contactPhone",
        "contactEmail",
        "note"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "addressLine1": {
          "type": "string"
        },
        "addressLine2": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "floor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "city": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "countryCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "zipCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "lat": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            {
              "type": "null"
            }
          ]
        },
        "lng": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "null"
            }
          ]
        },
        "contactName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "contactPhone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "contactEmail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object",
        "id",
        "reference",
        "kind",
        "status",
        "amount",
        "orderId",
        "deliveryId",
        "createdAt"
      ],
      "properties": {
        "object": {
          "const": "payment"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "reference": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "payment",
            "refund"
          ]
        },
        "status": {
          "type": "string"
        },
        "amount": {
          "$ref": "#/$defs/Money"
        },
        "orderId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "deliveryId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
