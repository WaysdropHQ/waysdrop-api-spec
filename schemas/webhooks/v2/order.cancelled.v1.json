{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.waysdrop.com/schemas/webhooks/order.cancelled.v1.json",
  "title": "Waysdrop webhook: order.cancelled",
  "description": "Envelope for `order.cancelled` (apiVersion 2026-11-25). Delivery is at least once: dedupe on `id`; drop events whose `sequence` is lower than one already seen for the same object.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "apiVersion",
    "createdAt",
    "livemode",
    "account",
    "sequence",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evt_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "type": {
      "const": "order.cancelled"
    },
    "apiVersion": {
      "const": "2026-11-25"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "livemode": {
      "type": "boolean"
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object"
      ],
      "properties": {
        "object": {
          "$ref": "#/$defs/Object"
        },
        "previous": {
          "type": "object",
          "description": "Changed fields only, when known"
        }
      }
    }
  },
  "$defs": {
    "Money": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amountMinor",
        "currency"
      ],
      "properties": {
        "amountMinor": {
          "type": "string",
          "pattern": "^-?[0-9]{1,30}$",
          "description": "Integer minor units as a string"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "Address": {
      "type": "object",
      "additionalProperties": false,
      "description": "Subset of PARTNER_ADDRESS_SELECT. Contact fields are the ones the partner supplied.",
      "required": [
        "id",
        "label",
        "addressLine1",
        "addressLine2",
        "floor",
        "city",
        "state",
        "region",
        "country",
        "countryCode",
        "zipCode",
        "lat",
        "lng",
        "contactName",
        "contactPhone",
        "contactEmail",
        "note"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "addressLine1": {
          "type": "string"
        },
        "addressLine2": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "floor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "city": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "countryCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "zipCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "lat": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            {
              "type": "null"
            }
          ]
        },
        "lng": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "null"
            }
          ]
        },
        "contactName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "contactPhone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "contactEmail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object",
        "id",
        "orderNumber",
        "status",
        "fulfillmentType",
        "deliveryId",
        "trackingId",
        "checkoutSessionId",
        "store",
        "items",
        "itemsTruncated",
        "subtotal",
        "deliveryFee",
        "total",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "object": {
          "const": "order"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "orderNumber": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "fulfillmentType": {
          "enum": [
            "DELIVERY",
            "CUSTOMER_PICKUP"
          ]
        },
        "deliveryId": {
          "type": "string",
          "format": "uuid"
        },
        "trackingId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "checkoutSessionId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "store": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name"
          ],
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "productId",
              "name",
              "quantity",
              "unitPrice"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "productId": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uuid"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "name": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "quantity": {
                "type": "integer",
                "minimum": 0
              },
              "unitPrice": {
                "$ref": "#/$defs/Money"
              }
            }
          }
        },
        "itemsTruncated": {
          "type": "boolean"
        },
        "subtotal": {
          "$ref": "#/$defs/Money"
        },
        "deliveryFee": {
          "$ref": "#/$defs/Money"
        },
        "total": {
          "$ref": "#/$defs/Money"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
