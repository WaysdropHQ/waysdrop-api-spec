{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://waysdrop.com/schemas/fixtures/oauth-pkce.json",
    "title": "PKCE test vector",
    "type": "object",
    "additionalProperties": false,
    "required": ["code_verifier", "code_challenge", "code_challenge_method"],
    "properties": {
        "code_verifier": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._~-]{43,128}$"
        },
        "code_challenge": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "code_challenge_method": { "const": "S256" }
    }
}
