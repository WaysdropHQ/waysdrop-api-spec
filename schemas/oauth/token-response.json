{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://waysdrop.com/schemas/oauth/token-response.json",
    "title": "TokenResponse",
    "type": "object",
    "properties": {
        "access_token": { "type": "string" },
        "token_type": { "type": "string", "const": "Bearer" },
        "expires_in": { "type": "integer", "minimum": 1 },
        "refresh_token": { "type": "string" },
        "scope": { "type": "string" }
    },
    "required": [
        "access_token",
        "token_type",
        "expires_in",
        "refresh_token",
        "scope"
    ]
}
